{
    "name": "sobha/qms-laravel-api",
    "type": "project",
    "description": "SOBHA Construction Quality & Defect Threshold Management System - Laravel REST API",
    "keywords": ["laravel", "qms", "construction", "defect-threshold", "inspection"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
